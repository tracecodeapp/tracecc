@@ -0,0 +1,29 @@
+//===-- tracecc1_clean_main.cpp - Direct upstream Clang frontend ----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Experimental direct entrypoint for measuring a general Clang frontend
+// without the GCC-compatible driver, linker, or unrelated LLVM utilities.
+// The caller supplies the ordinary cc1 argument vector, including "-cc1".
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/SmallVector.h"
+
+#include <cstdint>
+
+extern int cc1_main(llvm::ArrayRef<const char *> Argv, const char *Argv0,
+                    void *MainAddr);
+
+int main(int Argc, char **Argv) {
+  llvm::SmallVector<const char *, 64> Arguments;
+  Arguments.append(Argv + 1, Argv + Argc);
+  void *MainAddr = reinterpret_cast<void *>(
+      static_cast<intptr_t>(reinterpret_cast<intptr_t>(&main)));
+  return cc1_main(Arguments, Argv[0], MainAddr);
+}
diff --git a/clang/tools/driver/tracecc1-clean/tracecc_clean_main.cpp b/clang/tools/driver/tracecc1-clean/tracecc_clean_main.cpp
new file mode 100644
index 000000000..47bee03c8
--- /dev/null
+++ b/clang/tools/driver/tracecc1-clean/tracecc_clean_main.cpp
@@ -0,0 +1,50 @@
+//===-- tracecc_clean_main.cpp - Narrow TraceCC tool dispatcher -----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Experimental TraceKernel-facing entrypoint. It retains only the complete
+// Clang cc1 frontend and LLD's WebAssembly driver. The host supplies normalized
+// commands, so no GCC-compatible driver or unrelated linker flavors are kept.
+//
+//===----------------------------------------------------------------------===//
+
+#include "lld/Common/Driver.h"
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <cstdint>
+
+extern int cc1_main(llvm::ArrayRef<const char *> Argv, const char *Argv0,
+                    void *MainAddr);
+
+namespace lld {
+extern int unsafeLldMain(llvm::ArrayRef<const char *> args,
+                         llvm::raw_ostream &stdoutOS,
+                         llvm::raw_ostream &stderrOS,
+                         llvm::ArrayRef<DriverDef> drivers, bool exitEarly);
+}
+
+LLD_HAS_DRIVER(wasm)
+
+int main(int Argc, char **Argv) {
+  llvm::StringRef Program(Argv[0]);
+  if (Program.ends_with("wasm-ld") || Program.ends_with("tracewasmld")) {
+    const lld::DriverDef WasmDriver = {lld::Wasm, &lld::wasm::link};
+    return lld::unsafeLldMain(
+        llvm::ArrayRef<const char *>(Argv, Argv + Argc), llvm::outs(),
+        llvm::errs(), llvm::ArrayRef<lld::DriverDef>(&WasmDriver, 1),
+        /*exitEarly=*/true);
+  }
+
+  llvm::SmallVector<const char *, 64> Arguments;
+  Arguments.append(Argv + 1, Argv + Argc);
+  void *MainAddr = reinterpret_cast<void *>(
+      static_cast<intptr_t>(reinterpret_cast<intptr_t>(&main)));
+  return cc1_main(Arguments, Argv[0], MainAddr);
+}
diff --git a/clang/tools/driver/tracecc1-clean/tracecc_execute_compiler_invocation.cpp b/clang/tools/driver/tracecc1-clean/tracecc_execute_compiler_invocation.cpp
new file mode 100644
index 000000000..04c9ad7b5
--- /dev/null
+++ b/clang/tools/driver/tracecc1-clean/tracecc_execute_compiler_invocation.cpp
@@ -0,0 +1,79 @@
+//===-- tracecc_execute_compiler_invocation.cpp --------------------------===//
+//
+// Experimental TraceCC-owned frontend action dispatcher. This deliberately
+// keeps the ordinary C/C++ compile, preprocess, syntax-check, module, and PCH
+// actions while excluding Clang's IDE, source-rewrite, ExtractAPI, plugin, and
+// static-analyzer action graph from the browser compiler executable.
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/Basic/DiagnosticFrontend.h"
+#include "clang/CodeGen/CodeGenAction.h"
+#include "clang/Frontend/CompilerInstance.h"
+#include "clang/Frontend/FrontendActions.h"
+#include "clang/FrontendTool/Utils.h"
+#include "llvm/Support/BuryPointer.h"
+
+#include <memory>
+
+using namespace clang;
+
+namespace {
+
+std::unique_ptr<FrontendAction>
+createTraceCCFrontendAction(CompilerInstance &CI) {
+  using namespace clang::frontend;
+
+  switch (CI.getFrontendOpts().ProgramAction) {
+  case EmitAssembly:
+    return std::make_unique<EmitAssemblyAction>();
+  case EmitBC:
+    return std::make_unique<EmitBCAction>();
+  case EmitLLVM:
+    return std::make_unique<EmitLLVMAction>();
+  case EmitLLVMOnly:
+    return std::make_unique<EmitLLVMOnlyAction>();
+  case EmitCodeGenOnly:
+    return std::make_unique<EmitCodeGenOnlyAction>();
+  case EmitObj:
+    return std::make_unique<EmitObjAction>();
+  case GenerateModule:
+    return std::make_unique<GenerateModuleFromModuleMapAction>();
+  case GenerateModuleInterface:
+    return std::make_unique<GenerateModuleInterfaceAction>();
+  case GenerateReducedModuleInterface:
+    return std::make_unique<GenerateReducedModuleInterfaceAction>();
+  case GenerateHeaderUnit:
+    return std::make_unique<GenerateHeaderUnitAction>();
+  case GeneratePCH:
+    return std::make_unique<GeneratePCHAction>();
+  case InitOnly:
+    return std::make_unique<InitOnlyAction>();
+  case ParseSyntaxOnly:
+    return std::make_unique<SyntaxOnlyAction>();
+  case PrintPreprocessedInput:
+    return std::make_unique<PrintPreprocessedAction>();
+  case RunPreprocessorOnly:
+    return std::make_unique<PreprocessOnlyAction>();
+  case VerifyPCH:
+    return std::make_unique<VerifyPCHAction>();
+  default:
+    CI.getDiagnostics().Report(diag::err_fe_action_not_available)
+        << "TraceCC frontend action";
+    return nullptr;
+  }
+}
+
+} // namespace
+
+bool clang::ExecuteCompilerInvocation(CompilerInstance *Clang) {
+  std::unique_ptr<FrontendAction> Action =
+      createTraceCCFrontendAction(*Clang);
+  if (!Action)
+    return false;
+
+  const bool Success = Clang->ExecuteAction(*Action);
+  if (Clang->getFrontendOpts().DisableFree)
+    llvm::BuryPointer(std::move(Action));
+  return Success;
+}
diff --git a/clang/tools/driver/tracecc1-clean/tracecc_fixed_frontend.cpp b/clang/tools/driver/tracecc1-clean/tracecc_fixed_frontend.cpp
new file mode 100644
index 000000000..bd8dcd490
--- /dev/null
+++ b/clang/tools/driver/tracecc1-clean/tracecc_fixed_frontend.cpp
@@ -0,0 +1,160 @@
+//===-- tracecc_fixed_frontend.cpp - Fixed TraceCC frontend --------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Experimental TraceKernel-facing C/C++ frontend. The host selects one of two
+// fixed programs:
+//
+//   tracecc-cxx <source> <object> <sysroot> [pch]
+//   tracecc-c   <source> <object> <sysroot> [pch]
+//
+// The target, language standard, frontend action, and code-generation policy
+// are deliberately not representable as runtime arguments.
+//
+//===----------------------------------------------------------------------===//
+
+#include "clang/Basic/CodeGenOptions.h"
+#include "clang/Basic/DiagnosticOptions.h"
+#include "clang/Basic/LangOptions.h"
+#include "clang/Basic/LangStandard.h"
+#include "clang/Basic/TargetOptions.h"
+#include "clang/CodeGen/CodeGenAction.h"
+#include "clang/Frontend/CompilerInstance.h"
+#include "clang/Frontend/CompilerInvocation.h"
+#include "clang/Frontend/FrontendOptions.h"
+#include "clang/Lex/HeaderSearchOptions.h"
+#include "clang/Lex/PreprocessorOptions.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/IR/DebugInfoMetadata.h"
+#include "llvm/Support/Path.h"
+#include "llvm/Support/VirtualFileSystem.h"
+#include "llvm/TargetParser/Triple.h"
+
+#include <memory>
+#include <string>
+
+using namespace clang;
+
+namespace {
+
+void addSystemPath(HeaderSearchOptions &HeaderSearch, const std::string &Path) {
+  HeaderSearch.AddPath(Path, frontend::System, /*IsFramework=*/false,
+                       /*IgnoreSysRoot=*/true);
+}
+
+std::shared_ptr<CompilerInvocation>
+createInvocation(Language LanguageKind, llvm::StringRef SourcePath,
+                 llvm::StringRef OutputPath, llvm::StringRef Sysroot,
+                 llvm::StringRef PCHPath) {
+  auto Invocation = std::make_shared<CompilerInvocation>();
+  const llvm::Triple Triple("wasm32-unknown-wasip1");
+
+  PreprocessorOptions &Preprocessor = Invocation->getPreprocessorOpts();
+  LangOptions &Lang = Invocation->getLangOpts();
+  const LangStandard::Kind Standard =
+      LanguageKind == Language::CXX ? LangStandard::lang_cxx23
+                                    : LangStandard::lang_c17;
+  LangOptions::setLangDefaults(Lang, LanguageKind, Triple,
+                               Preprocessor.Includes, Standard);
+
+  TargetOptions &Target = Invocation->getTargetOpts();
+  Target.Triple = Triple.str();
+  Target.CPU = "generic";
+
+  if (LanguageKind == Language::CXX) {
+    Lang.Coroutines = true;
+    Lang.CPlusPlusModules = true;
+    Lang.Modules = true;
+    Lang.ModulesLocalVisibility = true;
+    Lang.CXXOperatorNames = true;
+    Lang.GNUKeywords = Lang.GNUMode;
+    Lang.MathErrno = false;
+    Lang.SizedDeallocation = true;
+    Lang.AlignedAllocation = true;
+    Lang.RTTI = true;
+    Lang.RTTIData = true;
+    Lang.Char8 = true;
+    Lang.WChar = true;
+    Lang.WCharIsSigned = true;
+    Lang.setComplexRange(LangOptions::CX_Full);
+  }
+  Lang.GNUCVersion = 4 * 100 * 100 + 2 * 100 + 1;
+  Lang.ImplicitModules = false;
+  Lang.SkipODRCheckInGMF = true;
+  Lang.Deprecated = true;
+  Lang.ConvergentFunctions = false;
+  Lang.setValueVisibilityMode(HiddenVisibility);
+  Lang.setTypeVisibilityMode(HiddenVisibility);
+  Lang.setDefaultFPContractMode(LangOptions::FPM_On);
+
+  HeaderSearchOptions &HeaderSearch = Invocation->getHeaderSearchOpts();
+  HeaderSearch.Sysroot = Sysroot.str();
+  HeaderSearch.ResourceDir = Sysroot.str();
+  if (LanguageKind == Language::CXX) {
+    addSystemPath(HeaderSearch,
+                  (Sysroot + "/include/wasm32-wasip1/c++/v1").str());
+    addSystemPath(HeaderSearch, (Sysroot + "/include/c++/v1").str());
+  }
+  addSystemPath(HeaderSearch, (Sysroot + "/include").str());
+  addSystemPath(HeaderSearch,
+                (Sysroot + "/include/wasm32-wasip1").str());
+  addSystemPath(HeaderSearch, (Sysroot + "/include").str());
+
+  if (!PCHPath.empty())
+    Preprocessor.ImplicitPCHInclude = PCHPath.str();
+
+  FrontendOptions &Frontend = Invocation->getFrontendOpts();
+  const InputKind Input(LanguageKind);
+  Frontend.DashX = Input;
+  Frontend.Inputs.emplace_back(SourcePath, Input);
+  Frontend.OutputFile = OutputPath.str();
+  Frontend.ProgramAction = frontend::EmitObj;
+  Frontend.DisableFree = false;
+
+  CodeGenOptions &CodeGen = Invocation->getCodeGenOpts();
+  CodeGen.OptimizationLevel = 0;
+  CodeGen.RelocationModel = llvm::Reloc::Static;
+  CodeGen.setFramePointer(CodeGenOptions::FramePointerKind::None);
+  CodeGen.setInlining(CodeGenOptions::OnlyAlwaysInlining);
+  CodeGen.setDebuggerTuning(llvm::DebuggerKind::GDB);
+  CodeGen.ClearASTBeforeBackend = true;
+  CodeGen.DiscardValueNames = true;
+  CodeGen.DirectAccessExternalData = true;
+  CodeGen.MergeAllConstants = false;
+  CodeGen.DebugNameTable =
+      static_cast<unsigned>(llvm::DICompileUnit::DebugNameTableKind::None);
+  CodeGen.XRayInstrumentationBundle.Mask = XRayInstrKind::All;
+  CodeGen.VerifyModule = false;
+  CodeGen.VerifyEach = false;
+  CodeGen.CXXCtorDtorAliases = true;
+  CodeGen.MainFileName = llvm::sys::path::filename(SourcePath).str();
+  CodeGen.DebugCompilationDir = "/";
+  CodeGen.CoverageCompilationDir = "/";
+
+  Invocation->getDiagnosticOpts().ErrorLimit = 19;
+  return Invocation;
+}
+
+} // namespace
+
+int traceccFixedFrontendMain(bool IsCXX, int Argc,
+                             const char *const *Argv) {
+  if ((Argc != 4 && Argc != 5) || Argv == nullptr)
+    return 64;
+
+  auto Invocation =
+      createInvocation(IsCXX ? Language::CXX : Language::C, Argv[1], Argv[2],
+                       Argv[3], Argc == 5 ? Argv[4] : "");
+  CompilerInstance Compiler(std::move(Invocation));
+  Compiler.setVirtualFileSystem(llvm::vfs::getRealFileSystem());
+  Compiler.createDiagnostics();
+  if (!Compiler.hasDiagnostics())
+    return 70;
+
+  EmitObjAction Action;
+  return Compiler.ExecuteAction(Action) ? 0 : 1;
+}
diff --git a/clang/tools/driver/tracecc1-clean/tracecc_reactor.cpp b/clang/tools/driver/tracecc1-clean/tracecc_reactor.cpp
new file mode 100644
index 000000000..2f3aac78f
--- /dev/null
+++ b/clang/tools/driver/tracecc1-clean/tracecc_reactor.cpp
@@ -0,0 +1,168 @@
+//===-- tracecc_reactor.cpp - Re-entrant TraceCC tool dispatcher ---------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Experimental TraceKernel-facing reactor entrypoint. The host initializes
+// the WASI reactor once and invokes tracecc_run() repeatedly with normalized
+// cc1 or Wasm LLD argument vectors. Each invocation owns and destroys its
+// frontend/linker state; the WebAssembly instance and libc allocator remain
+// warm and reuse their high-water memory.
+//
+//===----------------------------------------------------------------------===//
+
+#include "lld/Common/Driver.h"
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/Support/TargetSelect.h"
+#include "llvm/Support/raw_ostream.h"
+
+#include <cstdint>
+#include <cstdlib>
+
+#if defined(__LLVM_INSTR_PROFILE_GENERATE)
+#include <cstdio>
+#include <cstring>
+#endif
+
+extern int traceccFixedFrontendMain(bool IsCXX, int Argc,
+                                    const char *const *Argv);
+
+LLD_HAS_DRIVER(wasm)
+
+namespace {
+
+bool CanRunAgain = true;
+
+bool isWasmLinker(llvm::StringRef Program) {
+  return Program.ends_with("wasm-ld") || Program.ends_with("tracewasmld");
+}
+
+void initializeFrontendTarget() {
+  static const bool Initialized = [] {
+    LLVMInitializeWebAssemblyTargetInfo();
+    LLVMInitializeWebAssemblyTarget();
+    LLVMInitializeWebAssemblyTargetMC();
+    LLVMInitializeWebAssemblyAsmPrinter();
+    LLVMInitializeWebAssemblyAsmParser();
+    return true;
+  }();
+  (void)Initialized;
+}
+
+} // namespace
+
+extern "C" {
+
+__attribute__((export_name("tracecc_alloc"))) void *
+tracecc_alloc(uint32_t Size) {
+  return std::malloc(Size);
+}
+
+__attribute__((export_name("tracecc_free"))) void tracecc_free(void *Pointer) {
+  std::free(Pointer);
+}
+
+__attribute__((export_name("tracecc_can_run_again"))) int
+tracecc_can_run_again() {
+  return CanRunAgain ? 1 : 0;
+}
+
+__attribute__((export_name("tracecc_run"))) int
+tracecc_run(int Argc, const char *const *Argv) {
+  CanRunAgain = true;
+  if (Argc <= 0 || Argv == nullptr || Argv[0] == nullptr)
+    return 64;
+
+  llvm::StringRef Program(Argv[0]);
+  if (isWasmLinker(Program)) {
+    const lld::DriverDef WasmDriver = {lld::Wasm, &lld::wasm::link};
+    const lld::Result Result = lld::lldMain(
+        llvm::ArrayRef<const char *>(Argv, Argv + Argc), llvm::outs(),
+        llvm::errs(), llvm::ArrayRef<lld::DriverDef>(&WasmDriver, 1));
+    CanRunAgain = Result.canRunAgain;
+    return Result.canRunAgain ? Result.retCode : 70;
+  }
+
+  if (Program == "tracecc-cxx" || Program.ends_with("/tracecc-cxx")) {
+    initializeFrontendTarget();
+    return traceccFixedFrontendMain(/*IsCXX=*/true, Argc, Argv);
+  }
+  if (Program == "tracecc-c" || Program.ends_with("/tracecc-c")) {
+    initializeFrontendTarget();
+    return traceccFixedFrontendMain(/*IsCXX=*/false, Argc, Argv);
+  }
+  return 64;
+}
+
+#if defined(__LLVM_INSTR_PROFILE_GENERATE)
+
+int __llvm_profile_write_file(void);
+void __llvm_profile_set_filename(const char *Filename);
+
+__attribute__((export_name("tracecc_profile_write"))) int
+tracecc_profile_write(const char *Filename) {
+  if (Filename == nullptr)
+    return 64;
+  __llvm_profile_set_filename(Filename);
+  return __llvm_profile_write_file();
+}
+
+// Training-only driver for persistent, cross-host profile collection. A
+// Wasmtime process invokes this once, compiles every virtual path in the
+// mounted newline-delimited manifest, writes one aggregate profile, and exits.
+// It is absent from non-instrumented production builds.
+__attribute__((export_name("tracecc_train_manifest"))) int
+tracecc_train_manifest(uint32_t ShardIndex) {
+  std::FILE *Manifest = std::fopen("/training/manifest.txt", "r");
+  if (Manifest == nullptr)
+    return 66;
+
+  char SourcePath[4096];
+  uint32_t Completed = 0;
+  uint32_t Failed = 0;
+  while (std::fgets(SourcePath, sizeof(SourcePath), Manifest) != nullptr) {
+    const size_t Length = std::strlen(SourcePath);
+    if (Length == 0)
+      continue;
+    if (SourcePath[Length - 1] != '\n' && !std::feof(Manifest)) {
+      std::fclose(Manifest);
+      return 65;
+    }
+    SourcePath[std::strcspn(SourcePath, "\r\n")] = '\0';
+    if (SourcePath[0] == '\0')
+      continue;
+
+    const char *Args[] = {
+        "tracecc-cxx",
+        SourcePath,
+        "/workspace/train.o",
+        "/usr",
+        "/assets/tracecode_pch-codegen-common-event-helpers-v2.hpp.pch",
+    };
+    if (tracecc_run(5, Args) != 0)
+      ++Failed;
+    ++Completed;
+    if (Completed % 25 == 0)
+      std::fprintf(stderr, "tracecc-pgo shard=%u completed=%u failed=%u\n",
+                   ShardIndex, Completed, Failed);
+  }
+  std::fclose(Manifest);
+
+  char ProfilePath[128];
+  std::snprintf(ProfilePath, sizeof(ProfilePath),
+                "/profiles/tracecc-fixed-shard-%u.profraw", ShardIndex);
+  if (tracecc_profile_write(ProfilePath) != 0)
+    return 74;
+  std::fprintf(stderr,
+               "tracecc-pgo shard=%u complete=%u failed=%u profile=%s\n",
+               ShardIndex, Completed, Failed, ProfilePath);
+  return Failed == 0 ? 0 : 1;
+}
+
+#endif
+
+} // extern "C"
diff --git a/lld/tools/lld/tracewasmld.cpp b/lld/tools/lld/tracewasmld.cpp
new file mode 100644
index 000000000..59e23fbbe
--- /dev/null
+++ b/lld/tools/lld/tracewasmld.cpp
@@ -0,0 +1,34 @@
+//===- tracewasmld.cpp - TraceCC WebAssembly-only linker ------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// Experimental entrypoint for measuring LLD with only its WebAssembly driver.
+// The ordinary multi-flavor lld executable also retains ELF, COFF, Mach-O,
+// and MinGW dispatchers that TraceCC cannot use.
+//
+//===----------------------------------------------------------------------===//
+
+#include "lld/Common/Driver.h"
+#include "llvm/ADT/ArrayRef.h"
+#include "llvm/Support/raw_ostream.h"
+
+namespace lld {
+extern int unsafeLldMain(llvm::ArrayRef<const char *> args,
+                         llvm::raw_ostream &stdoutOS,
+                         llvm::raw_ostream &stderrOS,
+                         llvm::ArrayRef<DriverDef> drivers, bool exitEarly);
+}
+
+LLD_HAS_DRIVER(wasm)
+
+int main(int argc, char **argv) {
+  const lld::DriverDef wasmDriver = {lld::Wasm, &lld::wasm::link};
+  return lld::unsafeLldMain(
+      llvm::ArrayRef<const char *>(argv, argv + argc), llvm::outs(),
+      llvm::errs(), llvm::ArrayRef<lld::DriverDef>(&wasmDriver, 1),
+      /*exitEarly=*/true);
+}

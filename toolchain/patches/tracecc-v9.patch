--- /dev/null
+++ b/clang/tools/driver/tracecc1-clean/CMakeLists.txt
@@ -0,0 +1,125 @@
+set(LLVM_LINK_COMPONENTS
+  ${LLVM_TARGETS_TO_BUILD}
+  Analysis
+  CodeGen
+  Core
+  IPO
+  AggressiveInstCombine
+  InstCombine
+  Instrumentation
+  MC
+  MCParser
+  ObjCARCOpts
+  Option
+  ScalarOpts
+  Support
+  TargetParser
+  TransformUtils
+  Vectorize
+  )
+
+# Experimental upstream cc1 entrypoint. This retains Clang's complete frontend
+# invocation semantics while omitting the GCC-compatible driver, LLD, and LLVM
+# utility dispatcher from the executable.
+add_clang_tool(tracecc1-clean
+  tracecc1_clean_main.cpp
+  tracecc_execute_compiler_invocation.cpp
+  ../cc1_main.cpp
+
+  PARTIAL_SOURCES_INTENDED
+
+  DEPENDS
+  intrinsics_gen
+  target_parser_gen
+  )
+
+clang_target_link_libraries(tracecc1-clean
+  PRIVATE
+  clangBasic
+  clangCodeGen
+  clangFrontend
+  clangOptions
+  clangSerialization
+  )
+
+add_dependencies(tracecc1-clean clang-resource-headers)
+
+# Experimental TraceKernel-facing tool: direct cc1 plus Wasm-only LLD in one
+# module so their shared LLVM backend is not downloaded and compiled twice.
+add_clang_tool(tracecc-clean
+  tracecc_clean_main.cpp
+  tracecc_execute_compiler_invocation.cpp
+  ../cc1_main.cpp
+
+  PARTIAL_SOURCES_INTENDED
+
+  DEPENDS
+  intrinsics_gen
+  target_parser_gen
+  )
+
+clang_target_link_libraries(tracecc-clean
+  PRIVATE
+  clangBasic
+  clangCodeGen
+  clangFrontend
+  clangOptions
+  clangSerialization
+  )
+
+target_link_libraries(tracecc-clean
+  PRIVATE
+  lldCommon
+  lldWasm
+  )
+
+target_include_directories(tracecc-clean
+  PRIVATE
+  ${CMAKE_SOURCE_DIR}/../lld/include
+  )
+
+add_dependencies(tracecc-clean clang-resource-headers)
+
+# Experimental re-entrant TraceKernel-facing tool. Unlike tracecc-clean this
+# uses WASI's reactor execution model, returns from every command, and asks LLD
+# to destroy its per-link context. The host owns the argv storage and invokes
+# the exported tracecc_run() function directly.
+add_clang_tool(tracecc-reactor
+  tracecc_reactor.cpp
+  tracecc_fixed_frontend.cpp
+
+  PARTIAL_SOURCES_INTENDED
+
+  DEPENDS
+  intrinsics_gen
+  target_parser_gen
+  )
+
+clang_target_link_libraries(tracecc-reactor
+  PRIVATE
+  clangBasic
+  clangCodeGen
+  clangFrontend
+  clangOptions
+  clangSerialization
+  )
+
+target_link_libraries(tracecc-reactor
+  PRIVATE
+  lldCommon
+  lldWasm
+  )
+
+target_include_directories(tracecc-reactor
+  PRIVATE
+  ${CMAKE_SOURCE_DIR}/../lld/include
+  )
+
+target_link_options(tracecc-reactor
+  PRIVATE
+  -mexec-model=reactor
+  -Wl,--Map=/tmp/tracecc-reactor-fulllto.map
+  -Wl,--why-extract=/tmp/tracecc-reactor-fulllto-why-extract.txt
+  )
+
+add_dependencies(tracecc-reactor clang-resource-headers)
diff --git a/clang/tools/driver/tracecc1-clean/tracecc1_clean_main.cpp b/clang/tools/driver/tracecc1-clean/tracecc1_clean_main.cpp

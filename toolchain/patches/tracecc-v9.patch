diff --git a/clang/lib/CodeGen/TraceCCBackendUtil.cpp b/clang/lib/CodeGen/TraceCCBackendUtil.cpp
new file mode 100644
index 000000000..ab511ea2b
--- /dev/null
+++ b/clang/lib/CodeGen/TraceCCBackendUtil.cpp
@@ -0,0 +1,312 @@
+//===--- TraceCCBackendUtil.cpp - Restricted TraceCC backend --------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+//
+// This intentionally narrow BackendUtil implementation is for the TraceCC
+// compiler worker only.  TraceKernel owns the invocation contract, so the
+// generic Clang backend's support for plugins, profile instrumentation/use,
+// sanitizers, coverage, debug information, LTO, offload objects, bitcode
+// embedding, and every output type other than an object file is unavailable.
+//
+// The O0 semantic pipeline is deliberately not empty.  LLVM requires
+// mandatory always-inline lowering, and C++ coroutines require the O0 coroutine
+// lowering sequence.  We run exactly those operations without constructing the
+// generic PassBuilder pipeline or registering its extension/plugin callbacks.
+//===----------------------------------------------------------------------===//
+
+#include "clang/CodeGen/BackendUtil.h"
+#include "BackendConsumer.h"
+#include "clang/Basic/CodeGenOptions.h"
+#include "clang/Basic/Diagnostic.h"
+#include "clang/Basic/DiagnosticFrontend.h"
+#include "clang/Basic/LangOptions.h"
+#include "clang/Basic/TargetOptions.h"
+#include "clang/Frontend/CompilerInstance.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Analysis/AliasAnalysis.h"
+#include "llvm/Analysis/AssumptionCache.h"
+#include "llvm/Analysis/BasicAliasAnalysis.h"
+#include "llvm/Analysis/CGSCCPassManager.h"
+#include "llvm/Analysis/GlobalsModRef.h"
+#include "llvm/Analysis/LoopAnalysisManager.h"
+#include "llvm/Analysis/OptimizationRemarkEmitter.h"
+#include "llvm/Analysis/ProfileSummaryInfo.h"
+#include "llvm/Analysis/RuntimeLibcallInfo.h"
+#include "llvm/Analysis/ScopedNoAliasAA.h"
+#include "llvm/Analysis/TargetLibraryInfo.h"
+#include "llvm/Analysis/TargetTransformInfo.h"
+#include "llvm/Frontend/Driver/CodeGenOptions.h"
+#include "llvm/Analysis/TypeBasedAliasAnalysis.h"
+#include "llvm/IR/LegacyPassManager.h"
+#include "llvm/IR/Dominators.h"
+#include "llvm/IR/Module.h"
+#include "llvm/IR/PassManager.h"
+#include "llvm/IR/PassInstrumentation.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/PrettyStackTrace.h"
+#include "llvm/Support/Timer.h"
+#include "llvm/Target/TargetMachine.h"
+#include "llvm/Target/TargetOptions.h"
+#include "llvm/TargetParser/Triple.h"
+#include "llvm/Transforms/Coroutines/CoroCleanup.h"
+#include "llvm/Transforms/Coroutines/CoroConditionalWrapper.h"
+#include "llvm/Transforms/Coroutines/CoroEarly.h"
+#include "llvm/Transforms/Coroutines/CoroSplit.h"
+#include "llvm/Transforms/IPO/AlwaysInliner.h"
+#include "llvm/Transforms/IPO/GlobalDCE.h"
+
+using namespace clang;
+using namespace llvm;
+
+namespace {
+
+static bool rejectUnsupportedContract(CompilerInstance &CI, StringRef Reason) {
+  CI.getDiagnostics().Report(
+      CI.getDiagnostics().getCustomDiagID(
+          DiagnosticsEngine::Error,
+          "TraceCC lean backend only supports the fixed compiler contract: %0"))
+      << Reason;
+  return false;
+}
+
+static bool verifyTraceCCContract(CompilerInstance &CI,
+                                  const CodeGenOptions &CGOpts,
+                                  const llvm::Module &M, BackendAction Action) {
+  const llvm::Triple TargetTriple(M.getTargetTriple());
+  if (TargetTriple.getArch() != llvm::Triple::wasm32 ||
+      TargetTriple.getOS() != llvm::Triple::WASIp1)
+    return rejectUnsupportedContract(CI, "target must be wasm32-wasip1");
+  if (Action != Backend_EmitObj)
+    return rejectUnsupportedContract(CI, "output must be an object file");
+  if (CGOpts.OptimizationLevel != 0)
+    return rejectUnsupportedContract(CI, "optimization level must be -O0");
+  if (CGOpts.DisableLLVMPasses)
+    return rejectUnsupportedContract(CI, "LLVM passes may not be disabled");
+  if (CGOpts.hasProfileInstr() || CGOpts.hasProfileClangUse() ||
+      CGOpts.hasProfileIRUse() || !CGOpts.SampleProfileFile.empty() ||
+      !CGOpts.MemoryProfileUsePath.empty() ||
+      CGOpts.DebugInfoForProfiling || CGOpts.PseudoProbeForProfiling)
+    return rejectUnsupportedContract(CI, "profiles are unsupported");
+  if (!CI.getLangOpts().Sanitize.empty() || CGOpts.hasSanitizeCoverage() ||
+      CGOpts.hasSanitizeBinaryMetadata())
+    return rejectUnsupportedContract(CI, "sanitizers and coverage are unsupported");
+  if (CGOpts.XRayInstrumentFunctions || CGOpts.InstrumentForProfiling ||
+      CGOpts.CallFEntry || CGOpts.JMCInstrument)
+    return rejectUnsupportedContract(CI, "entry/exit instrumentation is unsupported");
+  if (CGOpts.getDebugInfo() != codegenoptions::NoDebugInfo)
+    return rejectUnsupportedContract(CI, "debug information is unsupported");
+  if (CGOpts.PrepareForLTO || CGOpts.PrepareForThinLTO || CGOpts.UnifiedLTO ||
+      !CGOpts.ThinLTOIndexFile.empty())
+    return rejectUnsupportedContract(CI, "LTO is unsupported");
+  if (!CGOpts.OffloadObjects.empty())
+    return rejectUnsupportedContract(CI, "offload objects are unsupported");
+  if (CGOpts.getEmbedBitcode() != CodeGenOptions::Embed_Off)
+    return rejectUnsupportedContract(CI, "embedded bitcode is unsupported");
+  if (!CI.getPassPlugins().empty())
+    return rejectUnsupportedContract(CI, "pass plugins are unsupported");
+  if (!CGOpts.PassBuilderCallbacks.empty())
+    return rejectUnsupportedContract(CI, "pass callbacks are unsupported");
+  if (CGOpts.MergeFunctions || CGOpts.VerifyModule || CGOpts.VerifyEach)
+    return rejectUnsupportedContract(CI, "optional LLVM passes are unsupported");
+  return true;
+}
+
+static std::optional<CodeModel::Model>
+getCodeModel(const CodeGenOptions &CGOpts) {
+  unsigned Model = StringSwitch<unsigned>(CGOpts.CodeModel)
+                       .Case("tiny", CodeModel::Tiny)
+                       .Case("small", CodeModel::Small)
+                       .Case("kernel", CodeModel::Kernel)
+                       .Case("medium", CodeModel::Medium)
+                       .Case("large", CodeModel::Large)
+                       .Cases({"default", ""}, ~1u)
+                       .Default(~0u);
+  assert(Model != ~0u && "invalid code model");
+  return Model == ~1u ? std::nullopt
+                       : std::optional<CodeModel::Model>(
+                             static_cast<CodeModel::Model>(Model));
+}
+
+static std::unique_ptr<TargetMachine>
+createTargetMachine(CompilerInstance &CI, llvm::Module &M) {
+  std::string Error;
+  const llvm::Triple &TargetTriple(M.getTargetTriple());
+  const llvm::Target *Target = TargetRegistry::lookupTarget(TargetTriple, Error);
+  if (!Target) {
+    CI.getDiagnostics().Report(diag::err_fe_unable_to_create_target) << Error;
+    return nullptr;
+  }
+
+  const CodeGenOptions &CGOpts = CI.getCodeGenOpts();
+  const clang::TargetOptions &TargetOpts = CI.getTargetOpts();
+  llvm::TargetOptions Options;
+  Options.ThreadModel = CI.getLangOpts().getThreadModel() ==
+                                LangOptions::ThreadModelKind::POSIX
+                            ? ThreadModel::POSIX
+                            : ThreadModel::Single;
+  Options.EmulatedTLS = CGOpts.EmulatedTLS;
+  Options.UseInitArray = CGOpts.UseInitArray;
+  Options.DisableIntegratedAS = CGOpts.DisableIntegratedAS;
+  Options.NoInfsFPMath = CI.getLangOpts().NoHonorInfs;
+  Options.NoNaNsFPMath = CI.getLangOpts().NoHonorNaNs;
+  Options.MCOptions.ABIName = TargetOpts.ABI;
+  if (CGOpts.hasWasmExceptions())
+    Options.ExceptionModel = ExceptionHandling::Wasm;
+
+  StringRef FloatABIName = CGOpts.FloatABI;
+  Options.FloatABIType = StringSwitch<llvm::FloatABI::ABIType>(FloatABIName)
+                             .Case("soft", llvm::FloatABI::Soft)
+                             .Case("softfp", llvm::FloatABI::Soft)
+                             .Case("hard", llvm::FloatABI::Hard)
+                             .Default(llvm::FloatABI::Default);
+  std::string Features = join(TargetOpts.Features, ",");
+  auto TM = std::unique_ptr<TargetMachine>(Target->createTargetMachine(
+      TargetTriple, TargetOpts.CPU, Features, Options, CGOpts.RelocationModel,
+      getCodeModel(CGOpts), CodeGenOptLevel::None));
+  if (TM)
+    TM->setLargeDataThreshold(CGOpts.LargeDataThreshold);
+  return TM;
+}
+
+static void registerLeanAnalyses(TargetMachine &TM,
+                                 TargetLibraryInfoImpl &TLII,
+                                 LoopAnalysisManager &LAM,
+                                 FunctionAnalysisManager &FAM,
+                                 CGSCCAnalysisManager &CGAM,
+                                 ModuleAnalysisManager &MAM) {
+  // These are the exact analyses consumed by the mandatory O0 and coroutine
+  // passes.  Keeping this list explicit prevents the generic PassBuilder
+  // registry from making every optional optimizer feature reachable.
+  MAM.registerPass([] { return ProfileSummaryAnalysis(); });
+  MAM.registerPass([] { return LazyCallGraphAnalysis(); });
+  MAM.registerPass([] { return GlobalsAA(); });
+  MAM.registerPass([] { return PassInstrumentationAnalysis(); });
+  CGAM.registerPass([] { return PassInstrumentationAnalysis(); });
+  FAM.registerPass([] { return PassInstrumentationAnalysis(); });
+  LAM.registerPass([] { return PassInstrumentationAnalysis(); });
+  FAM.registerPass([] { return AssumptionAnalysis(); });
+  FAM.registerPass([] { return BasicAA(); });
+  FAM.registerPass([] { return DominatorTreeAnalysis(); });
+  FAM.registerPass([] { return OptimizationRemarkEmitterAnalysis(); });
+  FAM.registerPass([] { return ScopedNoAliasAA(); });
+  FAM.registerPass([&TLII] { return TargetLibraryAnalysis(TLII); });
+  FAM.registerPass([&TM] { return TM.getTargetIRAnalysis(); });
+  FAM.registerPass([] { return TypeBasedAA(); });
+  FAM.registerPass([] {
+    AAManager AA;
+    AA.registerFunctionAnalysis<BasicAA>();
+    AA.registerFunctionAnalysis<ScopedNoAliasAA>();
+    AA.registerFunctionAnalysis<TypeBasedAA>();
+    AA.registerModuleAnalysis<GlobalsAA>();
+    return AA;
+  });
+
+  MAM.registerPass([&FAM] { return FunctionAnalysisManagerModuleProxy(FAM); });
+  MAM.registerPass([&CGAM] { return CGSCCAnalysisManagerModuleProxy(CGAM); });
+  CGAM.registerPass([&MAM] { return ModuleAnalysisManagerCGSCCProxy(MAM); });
+  CGAM.registerPass([] { return FunctionAnalysisManagerCGSCCProxy(); });
+  FAM.registerPass([&CGAM] { return CGSCCAnalysisManagerFunctionProxy(CGAM); });
+  FAM.registerPass([&MAM] { return ModuleAnalysisManagerFunctionProxy(MAM); });
+  FAM.registerPass([&LAM] { return LoopAnalysisManagerFunctionProxy(LAM); });
+  LAM.registerPass([&FAM] { return FunctionAnalysisManagerLoopProxy(FAM); });
+}
+
+static void runMandatoryO0Pipeline(llvm::Module &M, TargetMachine &TM) {
+  std::unique_ptr<TargetLibraryInfoImpl> TLII(
+      llvm::driver::createTLII(M.getTargetTriple(),
+                              llvm::driver::VectorLibrary::NoLibrary));
+  LoopAnalysisManager LAM;
+  FunctionAnalysisManager FAM;
+  CGSCCAnalysisManager CGAM;
+  ModuleAnalysisManager MAM;
+  registerLeanAnalyses(TM, *TLII, LAM, FAM, CGAM, MAM);
+
+  ModulePassManager MPM;
+  MPM.addPass(AlwaysInlinerPass(/*InsertLifetimeIntrinsics=*/false));
+  // Preserve the exact O0 CoroConditionalWrapper boundary from LLVM's default
+  // pipeline.  Besides avoiding work for the overwhelmingly common
+  // non-coroutine translation unit, the wrapper's analysis-preservation
+  // contract is part of the pipeline semantics.
+  ModulePassManager CoroPM;
+  CoroPM.addPass(CoroEarlyPass());
+  CGSCCPassManager CGPM;
+  CGPM.addPass(CoroSplitPass(/*OptimizeFrame=*/false));
+  CoroPM.addPass(createModuleToPostOrderCGSCCPassAdaptor(std::move(CGPM)));
+  CoroPM.addPass(CoroCleanupPass());
+  CoroPM.addPass(GlobalDCEPass());
+  MPM.addPass(CoroConditionalWrapper(std::move(CoroPM)));
+  // The upstream O0 pipeline also contains EntryExitInstrumenter, AllocToken,
+  // and annotation-remark hooks.  The fixed contract rejects every option
+  // that makes EntryExitInstrumenter observable; it does not enable alloc
+  // token lowering or annotation remarks.  Omitting those no-op hooks keeps
+  // their instrumentation/remarks closure out of this worker.
+  MPM.run(M, MAM);
+}
+
+static void runCodegen(CompilerInstance &CI, llvm::Module &M, TargetMachine &TM,
+                       raw_pwrite_stream &OS) {
+  legacy::PassManager PM;
+  PM.add(createTargetTransformInfoWrapperPass(TM.getTargetIRAnalysis()));
+  std::unique_ptr<TargetLibraryInfoImpl> TLII(llvm::driver::createTLII(
+      M.getTargetTriple(), CI.getCodeGenOpts().getVecLib()));
+  PM.add(new TargetLibraryInfoWrapperPass(*TLII));
+  const llvm::TargetOptions &Options = TM.Options;
+  PM.add(new RuntimeLibraryInfoWrapper(
+      M.getTargetTriple(), Options.ExceptionModel, Options.FloatABIType,
+      Options.EABIVersion, Options.MCOptions.ABIName, Options.VecLib));
+  if (TM.addPassesToEmitFile(PM, OS, nullptr, CodeGenFileType::ObjectFile,
+                             /*DisableVerify=*/true)) {
+    CI.getDiagnostics().Report(diag::err_fe_unable_to_interface_with_target);
+    return;
+  }
+  PrettyStackTraceString CrashInfo("TraceCC lean code generation");
+  PM.run(M);
+}
+
+} // namespace
+
+void clang::emitBackendOutput(CompilerInstance &CI, CodeGenOptions &CGOpts,
+                              StringRef TDesc, llvm::Module *M,
+                              BackendAction Action,
+                              IntrusiveRefCntPtr<vfs::FileSystem> VFS,
+                              std::unique_ptr<raw_pwrite_stream> OS,
+                              BackendConsumer *BC) {
+  (void)VFS;
+  (void)BC;
+  if (!verifyTraceCCContract(CI, CGOpts, *M, Action))
+    return;
+  std::unique_ptr<TargetMachine> TM = createTargetMachine(CI, *M);
+  if (!TM)
+    return;
+  M->setDataLayout(TM->createDataLayout());
+  if (M->getDataLayout().getStringRepresentation() != TDesc) {
+    CI.getDiagnostics().Report(diag::err_data_layout_mismatch)
+        << M->getDataLayout().getStringRepresentation() << TDesc;
+    return;
+  }
+  runMandatoryO0Pipeline(*M, *TM);
+  runCodegen(CI, *M, *TM, *OS);
+}
+
+void clang::EmbedBitcode(llvm::Module *M, const CodeGenOptions &CGOpts,
+                         MemoryBufferRef Buf) {
+  (void)M;
+  (void)CGOpts;
+  (void)Buf;
+  // The TraceCC contract rejects embed-bitcode in emitBackendOutput.  This
+  // no-op exists because CodeGenAction calls the hook before backend dispatch.
+}
+
+void clang::EmbedObject(llvm::Module *M, const CodeGenOptions &CGOpts,
+                        vfs::FileSystem &VFS, DiagnosticsEngine &Diags) {
+  (void)M;
+  (void)CGOpts;
+  (void)VFS;
+  (void)Diags;
+  // Same ordering caveat as EmbedBitcode: offload objects are rejected by the
+  // fixed contract before code generation, and never embedded by TraceCC.
+}
diff --git a/clang/tools/driver/tracecc1-clean/CMakeLists.txt b/clang/tools/driver/tracecc1-clean/CMakeLists.txt

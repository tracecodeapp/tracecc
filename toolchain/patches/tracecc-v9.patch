+llvm::Value *CodeGenFunction::getTypeSize(QualType Ty) {
+  ASTContext &C = getContext();
+  llvm::Value *Size = nullptr;
+  auto SizeInChars = C.getTypeSizeInChars(Ty);
+  if (SizeInChars.isZero()) {

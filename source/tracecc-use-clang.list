[clang]
default:forbid
source:*clang/lib/Basic/*=allow
source:*clang/lib/Lex/*=allow
source:*clang/lib/Parse/*=allow
source:*clang/lib/Sema/*=allow
source:*clang/lib/Serialization/*=allow
source:*clang/lib/Frontend/*=allow
source:*clang/lib/FrontendTool/*=allow
source:*clang/lib/Driver/*=allow
source:*clang/lib/CodeGen/*=allow
source:*llvm/lib/Support/*=allow
source:*llvm/lib/Option/*=allow
source:*llvm/lib/IR/*=allow
source:*llvm/lib/Bitcode/*=allow
source:*llvm/lib/MC/*=allow
source:*llvm/lib/CodeGen/*=allow
source:*llvm/lib/Target/WebAssembly/*=allow
